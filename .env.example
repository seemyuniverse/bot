DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
FLASK_SECRET_KEY=change_this_secret_key
COOKIE_SECURE=true
MASTODON_BASE_URL=https://occm.cc
MASTODON_ACCESS_TOKEN=your_bot_access_token

# 마스토돈 OAuth 설정 (관리자 화면 로그인용)
MASTODON_CLIENT_ID=your_client_key
MASTODON_CLIENT_SECRET=your_client_secret
ADMIN_ACCTS=admin_account

# OAuth 리다이렉트 URI (도메인에 맞게 설정)
OAUTH_REDIRECT_URI=https://your-domain.com/oauth/callback
